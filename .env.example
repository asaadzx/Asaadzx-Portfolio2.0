# Server-side secrets. Copy to `.env` for local development; in production set
# these as environment variables on the hosting provider (Vercel, Cloudflare,
# Netlify, ...) and never commit a real `.env`.

# Turso / libSQL connection. The app never sees these - only the server talks to
# the database.
DATABASE_URL=libsql://myportfolio-asaadzx.aws-eu-west-1.turso.io
DATABASE_AUTH_TOKEN=

# Optional. A GitHub token used to raise the api.github.com rate limit when
# proxying the public profile through `/api/github`. Without it the route still
# works, just rate-limited to unauthenticated limits (60/hour). Scope it
# read-only.
GITHUB_TOKEN=

# Optional but recommended. Bearer token required by `POST /api/status`, i.e.
# writing the live status text shown on the site. Must match the
# STATUS_API_TOKEN the Android app seeds from its own `.env`.
#
# When unset, writes are ungated and anyone who can reach the endpoint can
# overwrite your status. Set this.
STATUS_API_TOKEN=
